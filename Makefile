CXX      := g++
CXXFLAGS := -std=c++17 -Wall -Wextra -Wpedantic -O3 -march=native
CPPFLAGS := -Iinclude -MMD -MP

SRC_DIR   := src
BUILD_DIR := build
TARGET    := $(BUILD_DIR)/raytracer

SRCS := $(wildcard $(SRC_DIR)/*.cpp)
OBJS := $(SRCS:$(SRC_DIR)/%.cpp=$(BUILD_DIR)/%.o)
DEPS := $(OBJS:.o=.d)

.PHONY: all build run clean

all: build

build: $(TARGET)

# Link
$(TARGET): $(OBJS)
	$(CXX) $(OBJS) -o $@

# Compile: one .cpp -> one .o
$(BUILD_DIR)/%.o: $(SRC_DIR)/%.cpp | $(BUILD_DIR)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -c $< -o $@

$(BUILD_DIR):
	mkdir -p $@

NAME ?= image

run: $(TARGET)
	mkdir -p renders
	./$(TARGET) renders/$(NAME)

clean:
	rm -rf $(BUILD_DIR)

# Header dependency files generated by -MMD
-include $(DEPS)
